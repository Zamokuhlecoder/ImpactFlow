# Local frontend origin allowed by the API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Local PostgreSQL. Set a non-empty development password before starting Compose.
POSTGRES_DB=impactflow
POSTGRES_USER=impactflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Local PostgreSQL URL. Set this to match the credentials above.
# URL-encode special characters in the password.
IMPACTFLOW_DATABASE_URL=postgresql+psycopg://impactflow:<password>@localhost:5432/impactflow

# Airflow orchestration metadata database and local administrator.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=<airflow-development-password>
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<airflow-admin-password>
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_PORT=8080
IMPACTFLOW_AIRFLOW_BASE_URL=http://127.0.0.1:8080
IMPACTFLOW_AIRFLOW_USERNAME=admin
IMPACTFLOW_AIRFLOW_PASSWORD=<airflow-admin-password>
# dbt target database. Defaults to the local db Compose service.
DBT_HOST=db
DBT_PORT=5432
DBT_DATABASE=impactflow
DBT_USER=impactflow
DBT_PASSWORD=<postgres-development-password>
# Optional protection for ImpactFlow's orchestration proxy. Keep this secret.
# IMPACTFLOW_ORCHESTRATION_TOKEN=<orchestration-api-token>

# Alternatively, use the PostgreSQL connection string from your Neon dashboard.
# Standard postgresql:// URLs and sslmode=require are supported.
# IMPACTFLOW_DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Optional server-managed connector allowlist. Keep actual URLs and credentials private in .env.
# IMPACTFLOW_SOURCE_CONNECTIONS='{"example-api":{"kind":"rest","url":"https://example.org/programmes.json"},"example-db":{"kind":"postgresql","url":"postgresql://readonly:<password>@<host>/<database>?sslmode=require","schema_name":"public","table":"programme_import"}}'
