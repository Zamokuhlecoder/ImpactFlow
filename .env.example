# Local frontend origin allowed by the API.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Local PostgreSQL. Set a non-empty development password before starting Compose.
POSTGRES_DB=impactflow
POSTGRES_USER=impactflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Set this to match POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.
# URL-encode special characters in the password.
IMPACTFLOW_DATABASE_URL=postgresql+psycopg://impactflow:<password>@localhost:5432/impactflow
